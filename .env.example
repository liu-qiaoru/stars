# Local API
# Destructive developer tooling requires this exact marker and still defaults to dry-run.
MEDIA_AGENT_ENV=local
SERVER_HOST=127.0.0.1
SERVER_PORT=4000
JOB_COORDINATOR_ENABLED=true
JOB_COORDINATOR_INTERVAL_MS=5000
JOB_COORDINATOR_EMBEDDING_LIMIT=100

# Frontend API base URL (used by Next.js client-side code)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=media_agent
POSTGRES_USER=media_agent
POSTGRES_PASSWORD=media_agent_dev
DATABASE_URL=postgres://media_agent:media_agent_dev@127.0.0.1:5432/media_agent

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Local SigLIP2 model service for synchronous query embeddings
MODEL_SERVICE_URL=http://127.0.0.1:4020
MODEL_SERVICE_TIMEOUT_MS=10000
MODEL_SERVICE_HOST=127.0.0.1
MODEL_SERVICE_PORT=4020
# Phase 4 固定使用 google/siglip2-base-patch16-224，避免 Worker 与模型服务各自覆盖后漂移。
SIGLIP_DEVICE=auto

# Optional caption indexing and local VLM service. The default backend reuses
# the model already downloaded by Ollama instead of downloading HF safetensors.
CAPTION_INDEXING_ENABLED=false
LOCAL_VLM_ENABLED=false
CAPTION_SEARCH_ENABLED=false
LOCAL_VLM_SERVICE_URL=http://127.0.0.1:4030
LOCAL_VLM_SERVICE_HOST=127.0.0.1
LOCAL_VLM_SERVICE_PORT=4030
LOCAL_VLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VLM_MODEL=qwen2.5vl:7b
LOCAL_VLM_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct
LOCAL_VLM_MODEL_VERSION=qwen2.5-vl-7b-instruct
LOCAL_VLM_TIMEOUT_SECONDS=120

# Video indexing. Dense is appropriate for small local libraries; switch to
# balanced or light before indexing very large video libraries.
KEYFRAME_DENSITY=dense
SCENE_MIN_SECONDS=3
SCENE_MAX_SECONDS=30
SCENE_MAX_COUNT=2000
SCENE_CAPTION_MAX_FRAMES=6

# Optional Redis realtime channel
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379

# 检索 Agent：RightAPI glm-5.3；部署、执行器与逐 run 授权同时满足才调用。
# 用户查询与素材文字分别授权。多轮循环不会自动发送图片或本地路径。
ALLOW_EXTERNAL_LLM=false
# RightAPI glm-5.3 文本 Agent 使用 Chat Completions；凭证存在不会自动启用外发。
RIGHT_CODE_BASE_URL=https://www.rightapi.ai/flash
RIGHT_CODE_API_KEY=
# 单次 RightAPI HTTP 请求上限，单位为毫秒；超时结果不明时必须由 /retry-unknown 授权重试。
AGENT_TOOL_TIMEOUT_MS=10000
# 外部意图/决策模型的独立等待上限，单位毫秒；默认 60 秒，不影响本地工具超时。
AGENT_MODEL_TIMEOUT_MS=60000
# 每个 run 最多执行的搜索/详情工具总次数（1～10）。模型决策另有派生硬上限。
# 兼容已有部署的总工具硬上限；未设置下面新总额时仍保留此值。
AGENT_MAX_STEPS=4
# 分类预算；搜索包含原文首轮。新总额必须显式配置，本次不修改实际.env。
# AGENT_RETRIEVAL_MAX_TOOL_CALLS=9
AGENT_RETRIEVAL_MAX_SEARCH_CALLS=3
AGENT_RETRIEVAL_MAX_DETAIL_CALLS=6
AGENT_RETRIEVAL_MAX_MODEL_CALLS=8
# 新图文协议：原文召回后同一次DeepSeek请求判断命中图文并决定下一动作。
# 外部开关仍默认关闭；每任务素材文字、20候选单帧、最终重排各自独立授权。
AGENT_RETRIEVAL_EVIDENCE_MODE=matched_multimodal
AGENT_RETRIEVAL_MODEL=deepseek-v4-flash
# 旧任务/部署兼容：不配置EVIDENCE_MODE时为overview；该模式默认glm-5.3。
AGENT_SCENE_INSPECTION_ENABLED=false
# 只有完整人工质量资格记录才可能启用对应冻结查询；默认缺省保留基线。
# AGENT_RETRIEVAL_QUALITY_REPORT=/absolute/path/to/qualified-report.json
# run 从创建开始的总时间上限，单位毫秒（含排队和等待用户时间）。
AGENT_RETRIEVAL_TIMEOUT_MS=600000
# 连续无进展轮次（1～5）与明确失败的重试次数（0～2）；未知外部结果不自动重试。
AGENT_RETRIEVAL_MAX_NO_PROGRESS=2
AGENT_RETRIEVAL_MAX_RETRIES=1
# 默认仍关闭，避免仅填写凭证就自动产生外部调用和费用。完成部署授权后再显式设为 true。
AGENT_EXECUTOR_ENABLED=false
AGENT_EXECUTOR_INTERVAL_MS=2000
# 租约毫秒数必须覆盖活动、工具和模型时限中的最大值，再留 5 秒数据库提交余量。
AGENT_LEASE_DURATION_MS=130000
# 单个活动步骤最多运行 120 秒；等待用户输入不计入此时间。
AGENT_ACTIVITY_TIMEOUT_MS=120000
# 等待用户输入/选择/确认的最长保留时间，单位为秒，默认 7 天。
AGENT_WAITING_TTL_SECONDS=604800
# Web 读取该默认值后约每 2 秒轮询；设置页可在当前 Server 进程内覆盖。
AGENT_WEB_POLL_INTERVAL_MS=2000

# Optional search query expansion. When enabled, only the user's search query is
# sent to the provider; local media paths and search results are not included.
QUERY_EXPANSION_PROVIDER=none
QUERY_EXPANSION_TIMEOUT_MS=10000
QUERY_EXPANSION_MAX_VARIANTS=3
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Phase E qwen3-vl-rerank 真实适配器。仅填写凭证不会启用图片外发；必须在每次真实
# smoke 获得新授权后，才把 provider 显式改为 dashscope。业务空间与 API Key 必须同属北京。
SHADOW_RERANK_PROVIDER=disabled
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_API_KEY=
# 用户主动开启的产品 Rerank 使用独立闸门；默认关闭，不能由 API Key 自动启用。
AGENT_RERANK_PROVIDER=disabled
# 一次 Top-20 多模态重排的硬超时，单位毫秒；正式接入门槛按 p95 <= 180 秒评估。
AGENT_RERANK_TIMEOUT_MS=180000
# 首次 smoke 固定 1；后续即使另行授权也不得超过 4。Server 还会在每次派发前按
# 单请求理论最高 ¥0.216 预留预算，任何既有调用用量未知时立即停止。
SHADOW_RERANK_MAX_CALLS=1
SHADOW_RERANK_MAX_COST_CNY=0.5

# Phase F qwen3.7-plus 视觉条件复核。默认 disabled；仅配置 RightAPI Key 或开启
# AgentIntent 都不会授权图片外发。真实运行还必须在 Evaluation 中创建一次指纹绑定的视觉授权。
VLM_REVIEW_PROVIDER=disabled
VLM_REVIEW_MAX_CALLS=84
VLM_REVIEW_MAX_COST_CNY=5
VLM_REVIEW_TIMEOUT_MS=180000

# Local media-agent storage
MEDIA_AGENT_HOME=.media-agent
MEDIA_AGENT_CACHE_DIR=.media-agent/cache
MEDIA_AGENT_EXPORT_DIR=.media-agent/exports
MEDIA_AGENT_LOG_DIR=.media-agent/logs
